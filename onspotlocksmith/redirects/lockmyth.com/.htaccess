# 301 everything on lockmyth.com to its equivalent on https://onspotlocksmith.com.
# Generated by build.py — edit that, not this file.

RewriteEngine On

# Paths that exist on the live site keep their page (and their query string)
RewriteRule ^(about|automotive|blog|commercial|contact-us|emergency-24-7|emergency-car-locksmith-services-in-san-luis-obispo-a-lifesaver-in-your-hour-of-need|emergency-locksmith-services-fast-help-for-san-luis-obispo-residents|ensuring-elite-privacy-luxury-car-locksmith-services-in-paso-robles|how-to-handle-a-car-lockout-tips-for-san-luis-obispo-drivers|locksmith-adelaida-ca|locksmith-arroyo-grande-ca|locksmith-asuncion-ca|locksmith-atascadero-ca|locksmith-avila-beach-ca|locksmith-callender-ca|locksmith-cambria-ca|locksmith-cayucos-ca|locksmith-creston-ca|locksmith-edna-ca|locksmith-grover-beach-ca|locksmith-lake-nacimiento-ca|locksmith-los-osos-ca|locksmith-morro-bay-ca|locksmith-nipomo-ca|locksmith-oceano-ca|locksmith-paso-robles-ca|locksmith-pismo-beach-ca|locksmith-san-luis-obispo-ca|locksmith-san-miguel-ca|locksmith-santa-margarita-ca|locksmith-shandon-ca|locksmith-templeton-ca|lost-motorcycle-keys-in-san-luis-obispo-heres-your-solution|mobile-locksmith-services-fast-relief-for-car-lock-issues-in-san-luis-obispo|privacy-policy|residential|service-areas|terms-of-service|the-rising-threat-of-scam-locksmiths-on-google-how-to-identify-and-avoid-them|what-owner-operated-means-when-you-call-a-locksmith)\.html$ https://onspotlocksmith.com/$1.html [R=301,L]

# Extensionless paths the old site used, mapped to their nearest equivalent
RewriteRule ^about/?$ https://onspotlocksmith.com/about.html [R=301,L]
RewriteRule ^about-us/?$ https://onspotlocksmith.com/about.html [R=301,L]
RewriteRule ^contact/?$ https://onspotlocksmith.com/contact-us.html [R=301,L]
RewriteRule ^contact-us/?$ https://onspotlocksmith.com/contact-us.html [R=301,L]
RewriteRule ^services/?$ https://onspotlocksmith.com/ [R=301,L]
RewriteRule ^our-services/?$ https://onspotlocksmith.com/ [R=301,L]
RewriteRule ^service-areas/?$ https://onspotlocksmith.com/service-areas.html [R=301,L]
RewriteRule ^areas-we-serve/?$ https://onspotlocksmith.com/service-areas.html [R=301,L]
RewriteRule ^locations/?$ https://onspotlocksmith.com/service-areas.html [R=301,L]
RewriteRule ^blog/?$ https://onspotlocksmith.com/blog.html [R=301,L]
RewriteRule ^news/?$ https://onspotlocksmith.com/blog.html [R=301,L]
RewriteRule ^automotive/?$ https://onspotlocksmith.com/automotive.html [R=301,L]
RewriteRule ^auto/?$ https://onspotlocksmith.com/automotive.html [R=301,L]
RewriteRule ^car-keys/?$ https://onspotlocksmith.com/automotive.html [R=301,L]
RewriteRule ^residential/?$ https://onspotlocksmith.com/residential.html [R=301,L]
RewriteRule ^home/?$ https://onspotlocksmith.com/residential.html [R=301,L]
RewriteRule ^commercial/?$ https://onspotlocksmith.com/commercial.html [R=301,L]
RewriteRule ^business/?$ https://onspotlocksmith.com/commercial.html [R=301,L]
RewriteRule ^emergency/?$ https://onspotlocksmith.com/emergency-24-7.html [R=301,L]
RewriteRule ^emergency-24-7/?$ https://onspotlocksmith.com/emergency-24-7.html [R=301,L]
RewriteRule ^24-7/?$ https://onspotlocksmith.com/emergency-24-7.html [R=301,L]

# Everything else — the old URL structure is gone, so send it to the home page
RewriteRule ^ https://onspotlocksmith.com/ [R=301,L]

# Belt and braces: if mod_rewrite is unavailable the index below still
# forwards, and this keeps directory listings off in the meantime.
Options -Indexes
