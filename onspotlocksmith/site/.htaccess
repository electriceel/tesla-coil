RewriteEngine On

# Force HTTPS and non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Legacy WordPress-style directory URLs -> flat pages
RewriteRule ^(about|blog|automotive|residential|commercial|emergency-24-7|service-areas|contact-us)/?$ /$1.html [R=301,L]

# Consolidated city page URLs (old inconsistent patterns -> locksmith-<city>-ca.html)
Redirect 301 /san-luis-obispo-ca-locksmith-services.html /locksmith-san-luis-obispo-ca.html
Redirect 301 /service-areas-paso-robles.html /locksmith-paso-robles-ca.html
Redirect 301 /premier-locksmith-services-in-atascadero-ca.html /locksmith-atascadero-ca.html
Redirect 301 /service-areas-templeton.html /locksmith-templeton-ca.html
Redirect 301 /service-areas-san-miguel.html /locksmith-san-miguel-ca.html
Redirect 301 /service-areas-santa-margarita.html /locksmith-santa-margarita-ca.html
Redirect 301 /your-trusted-locksmith-partner-in-creston-ca.html /locksmith-creston-ca.html
Redirect 301 /service-areas-shandon.html /locksmith-shandon-ca.html
Redirect 301 /adelaide-ca.html /locksmith-adelaide-ca.html
Redirect 301 /asuncion-ca-locksmith-services.html /locksmith-asuncion-ca.html
Redirect 301 /your-trusted-locksmith-partner-in-lake-nacimiento-ca.html /locksmith-lake-nacimiento-ca.html
Redirect 301 /premier-locksmith-services-in-cambria-ca.html /locksmith-cambria-ca.html
Redirect 301 /premier-locksmith-services-in-cayucos-ca.html /locksmith-cayucos-ca.html
Redirect 301 /trusted-locksmith-services-in-morro-bay-ca.html /locksmith-morro-bay-ca.html
Redirect 301 /premier-locksmith-services-in-los-osos-ca.html /locksmith-los-osos-ca.html
Redirect 301 /your-trusted-locksmith-partner-in-avila-beach-ca.html /locksmith-avila-beach-ca.html
Redirect 301 /service-areas-pismo-beach.html /locksmith-pismo-beach-ca.html
Redirect 301 /your-trusted-locksmith-partner-in-grover-beach-ca.html /locksmith-grover-beach-ca.html
Redirect 301 /service-areas-oceano.html /locksmith-oceano-ca.html
Redirect 301 /arroyo-grande-ca-locksmith-services.html /locksmith-arroyo-grande-ca.html
Redirect 301 /service-areas-nipomo.html /locksmith-nipomo-ca.html
Redirect 301 /comprehensive-locksmith-services-in-callender-ca.html /locksmith-callender-ca.html
Redirect 301 /premier-locksmith-services-in-edna-ca.html /locksmith-edna-ca.html

# Thin category archives -> blog
Redirect 301 /category-car-locksmith-services.html /blog.html
Redirect 301 /category-handling-car-lockouts.html /blog.html
Redirect 301 /category-locksmith-services.html /blog.html
Redirect 301 /category-mobile-locksmith-services.html /blog.html
Redirect 301 /category-motorcycle-key-replacement.html /blog.html

# Canonical hygiene
Redirect 301 /index.html /

# Caching & compression
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType text/css "access plus 7 days"
</IfModule>
AddDefaultCharset utf-8
